<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.admin.FrmMenuPrincipal">
  <grid id="27dc6" binding="menuprincipalPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="542" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="43c27" binding="panelBotonera" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d50e8" class="javax.swing.JButton" binding="menuPrincipalButton" default-binding="true">
